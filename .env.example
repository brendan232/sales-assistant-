# Claude. Leave unset if you have run `ant auth login`.
ANTHROPIC_API_KEY=

# Who the assistant works for (used in drafts and to recognise your side of a thread).
REP_NAME=
REP_EMAIL=
COMPANY_NAME=

# HubSpot service key (Development > Keys > Service keys). Scopes: crm.objects.deals.read, crm.objects.contacts.read,
# crm.objects.companies.read, and (for notes/tasks) crm.objects.deals.write + crm.objects.contacts.write.
HUBSPOT_ACCESS_TOKEN=
# Optional: only look at deals owned by this HubSpot owner id.
HUBSPOT_OWNER_ID=

# Fathom API key (Fathom > Settings > API Access).
FATHOM_API_KEY=

# Google OAuth desktop-app client secrets file (Gmail + Calendar). First run opens a browser to consent.
GOOGLE_CLIENT_SECRETS=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Set to 1 to force every connector onto the bundled sample data.
SALES_ASSISTANT_MOCK=
